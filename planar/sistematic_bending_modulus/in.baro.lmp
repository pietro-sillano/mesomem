# nohup mpirun -np 16 lmp_radial -i baro_radial.lmp  -v ktilt 15.0 -v ksplay 15.0 -v N 10000 -v rcut 2.5 -v wc 1.8 -v zeta 4.0 -v T 0.25 > log.out 2>&1 &!

variable v_rcut string ${rcut}
variable v_splay string ${ksplay}
variable v_tilt string ${ktilt}
variable v_wc string ${wc}
variable v_N string ${N}
variable v_zeta string ${zeta}
variable v_T string ${T}


variable t_dump equal 10000 # for N=400
variable n_frame equal 250
variable t_run equal ${n_frame}*${t_dump}


# Generated by python script of Adam Prada
units      lj
atom_style hybrid sphere dipole molecular
dimension   3 
boundary   p p p
processors   * * 1               # set the number of MPI processors in Lz direction to 1

read_data ../input_config/lattice_d_0.90_N_${N}

variable my_diameter equal 4.0
set      type 1 diameter ${my_diameter}
variable my_volume equal (4.0/3.0)*PI*((${my_diameter}*0.5)^3)
# in principle i want to keep my mass fixed for unit conversions! density I dont really care
variable my_mass equal 1.0
variable my_density equal ${my_mass}/${my_volume}

set      type 1 density ${my_density}
print "m:${my_mass} V:${my_volume} rho:${my_density}" file info_mass.dat screen yes

#********************************************************************************
# Other variables
#********************************************************************************
# Each membrane sphere/ellipsoid has 1 hidden degree of freedom
variable    kinetic_energy     equal    ke
variable    potential_energy   equal    pe
variable    total_energy       equal    etotal
#************************************
# Box size calculation
#************************************
variable xwidth equal xhi-xlo
variable ywidth equal yhi-ylo
variable zwidth equal zhi-zlo
#********************************************************************************
# thermodynamic parameters
#********************************************************************************
# Target temperature
variable my_temp equal ${v_T}
# Damping parameter of thermostat
variable my_Tdamp equal 1.000000
# Target pressure
variable my_press equal -0.0
# Damping parameter for barostat
variable my_Pdamp equal 400.000000
# Drag parameter for barostat
variable my_drag equal 1.000000
variable my_nreset equal 100



#********************************************************************************
# pair style
#********************************************************************************
# global cutoff DEBUG
pair_style      membrane_sillanov2 ${v_rcut}
# i j sigma eps ktilt ksplay rcut weight_rc
pair_coeff      1 1 1.0 1.0 ${v_tilt} ${v_splay} ${v_rcut} ${v_wc} ${v_zeta} 0.0



#********************************************************************************
# neigh modify
#********************************************************************************
# These should be optimised for the particular simulation

# Reduce the delay from default 10 to 2 to get rid of dangeours builds
#neigh_modify   delay 2
# Max number stored in a single neighbor page
# Communicate atoms between processors from this far away
#comm_modify   cutoff 50
#********************************************************************************
# Various computes
#********************************************************************************
compute C_E_kin_trans all ke
compute C_E_kin_rot all erotate/sphere
compute C_E_pot all pe
variable V_E_tot equal c_C_E_pot+c_C_E_kin_trans+c_C_E_kin_rot

# for fix commands, the 1st and 2nd arguments are ID and group-ID, then the style (subcommand)
# ID = user assigned name for the fix
# group-ID = ID of the group of atoms to apply the fix to
# ave/time = output global variables, possibly with averaging over time
# Nevery = input values this every timesteps
# Nfreq = calculate averages every this time step
# list of values with v_ prepended = value calculated by an equal style or vector-style variable with name
# file lmpout_energy.dat = the keyword + argument
fix fix_energies all ave/time ${t_dump} 1 ${t_dump}  v_V_E_tot c_C_E_pot c_C_E_kin_trans c_C_E_kin_rot file equilib_eng.dat

#************************************
# Temperature computes
#************************************
compute C_temp_def all temp/sphere
#************************************
# Default pressure compute
#************************************
compute C_press_def all pressure C_temp_def

# If correcting the number of degrees of freedom
#compute_modify C_temp_def dynamic/dof no extra/dof ${dofsub}

# ^ This compute gives a scalar, which is the total pressure (P_xx+P_yy+P_zz)/3
# but it also gives a vector with components P_xx, P_yy, P_zz, P_xy, P_xz, P_yz
fix fix_eqn_deft all ave/time ${t_dump} 1 ${t_dump} c_C_press_def c_C_press_def[1] c_C_press_def[2] c_C_press_def[3] c_C_press_def[4] c_C_press_def[5] c_C_press_def[6] c_C_temp_def file equilibr_press_default.dat

#************************************
# Translation pressure compute
#************************************
compute        C_temp_tran all temp
compute        C_press_tran all pressure C_temp_tran
fix fix_eqn_tran all ave/time ${t_dump} 1 ${t_dump} c_C_press_tran c_C_press_tran[1] c_C_press_tran[2] c_C_press_tran[3] c_C_press_tran[4] c_C_press_tran[5] c_C_press_tran[6] c_C_temp_tran file equilibr_press_tran.dat

#**************************************************
# Computes used for barostatting and thermostatting
#**************************************************
compute        C_temp_baro all temp
compute        C_press_baro all pressure C_temp_baro
fix fix_eqn_baro all ave/time ${t_dump} 1 ${t_dump} c_C_press_baro c_C_press_baro[1] c_C_press_baro[2] c_C_press_baro[3] c_C_press_baro[4] c_C_press_baro[5] c_C_press_baro[6] c_C_temp_tran file equilibr_press_baro.dat

#************************************
# Custom translation pressure calculation
#************************************
compute        peratom_null all stress/atom NULL
compute        p_null all reduce sum c_peratom_null[1] c_peratom_null[2] c_peratom_null[3] c_peratom_null[4] c_peratom_null[5] c_peratom_null[6]
variable       V_press_scal_null equal -(c_p_null[1]+c_p_null[2]+c_p_null[3])/(3*vol)
variable       V_press_vec_null vector -c_p_null/vol
fix fix_eqn_null all ave/time ${t_dump} 1 ${t_dump} v_V_press_scal_null v_V_press_vec_null[1] v_V_press_vec_null[2] v_V_press_vec_null[3] v_V_press_vec_null[4] v_V_press_vec_null[5] v_V_press_vec_null[6] c_C_temp_tran file equilibr_press_custom.dat

#************************************
# Custom translation pressure calculation without volume
#************************************
compute        peratom_null2 all stress/atom NULL
compute        p_null2 all reduce sum c_peratom_null2[1] c_peratom_null2[2] c_peratom_null2[3] c_peratom_null2[4] c_peratom_null2[5] c_peratom_null2[6]
variable       V_press_scal_null2 equal -(c_p_null2[1]+c_p_null2[2]+c_p_null2[3])/(3)
variable       V_press_vec_null2 vector -c_p_null2
fix fix_eqn_null2 all ave/time ${t_dump} 1 ${t_dump} v_V_press_scal_null2 v_V_press_vec_null2[1] v_V_press_vec_null2[2] v_V_press_vec_null2[3] v_V_press_vec_null2[4] v_V_press_vec_null2[5] v_V_press_vec_null2[6] c_C_temp_tran file equilibr_press_no_vol.dat
#********************************************************************************
# NVT equilibration
#********************************************************************************
# Heating up the membrane, before turning on the barostat
# (The barostat dislikes zero temperature)
# for the choice of angmom, see https://docs.lammps.org/fix_langevin.html
fix fLANG_standard         all   langevin 0.05 ${my_temp} 0.5 123 zero yes omega yes

dump coords all custom ${t_dump} position_eq.lammpstrj id type xu yu zu ix iy iz mux muy muz

fix fNVE_membrane all  nve/sphere update dipole
timestep   0.010000

thermo      ${t_dump}
thermo_style custom step spcpu cpuremain temp pe c_C_press_baro c_C_E_kin_rot c_C_E_kin_trans

minimize 0.0 1.0e-8 1000 100000

#*********************************************
# NVT equilibration
#*********************************************
run   50000


unfix fNVE_membrane
unfix fLANG_standard
#********************************************************************************
# Constant pressure equilibration
#********************************************************************************
fix fLANG_standard         all   langevin ${my_temp} ${my_temp} ${my_Tdamp} 5543 zero yes omega yes
fix      fNPH_membrane         all     nph/sphere x ${my_press} ${my_press} ${my_Pdamp}  y ${my_press} ${my_press} ${my_Pdamp} couple xy drag ${my_drag} dilate all nreset ${my_nreset} update dipole
fix_modify fNPH_membrane temp C_temp_baro press C_press_baro
run   100000
unfix fNPH_membrane
write_restart lmpout_restart_02_t_npt.dat
undump coords
#********************************************************************************
# Production run
#********************************************************************************
compute msd all msd
fix      fNPH_membrane         all     nph/sphere x ${my_press} ${my_press} ${my_Pdamp}  y ${my_press} ${my_press} ${my_Pdamp} couple xy drag ${my_drag} dilate all nreset ${my_nreset} update dipole
fix_modify fNPH_membrane temp C_temp_baro press C_press_baro

fix fix_boxsize_output all ave/time ${t_dump} 1 ${t_dump} v_xwidth v_ywidth v_zwidth format "%18.6f" file boxsize.dat

fix fix_bar_deft all ave/time ${t_dump} 1 ${t_dump} c_C_press_def c_C_press_def[1] c_C_press_def[2] c_C_press_def[3] c_C_press_def[4] c_C_press_def[5] c_C_press_def[6] c_C_temp_def file run_press.dat

fix fix_bar_tran all ave/time ${t_dump} 1 ${t_dump} c_C_press_tran c_C_press_tran[1] c_C_press_tran[2] c_C_press_tran[3] c_C_press_tran[4] c_C_press_tran[5] c_C_press_tran[6] c_C_temp_tran file run_press_tran.dat

dump coords all custom ${t_dump} position_run.lammpstrj id type xu yu zu ix iy iz mux muy muz
run   ${t_run}

