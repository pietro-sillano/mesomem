# mpirun -np 4 lmp_radial -i in.phase.lmp -v ktilt 15.0 -v ksplay 1.0 -v rcut 2.5 -v wc 2.0 -v zeta 5.0 -v alpha1 0.0 -v alpha12 0.0 -v alpha2 0.5

variable v_rcut string ${rcut}
variable v_splay string ${ksplay}
variable v_tilt string ${ktilt}
variable v_wc string ${wc}
variable v_zeta string ${zeta}
variable v_alpha1 string ${alpha1}
variable v_alpha2 string ${alpha2}
variable v_alpha12 string ${alpha12}

variable t_dump equal 10000

units           lj
atom_style      hybrid sphere dipole molecular
neighbor 1.0 bin
neigh_modify delay 0 every 1 check yes

dimension       3
boundary        p p p
processors      * * 1 


# read_data lattice_d_0.80_N_2500_no_PBC
# read_data lattice_d_0.80_N_100_phase
read_data ../lattice_d_0.90_N_2500_phase


variable my_diameter equal 4.0
set      type 1 diameter ${my_diameter}
variable my_volume equal (4.0/3.0)*PI*((${my_diameter}*0.5)^3)
# in principle i want to keep my mass fixed for unit conversions! density I dont really care
variable my_mass equal 1.0
variable my_density equal ${my_mass}/${my_volume}
set      type 1 density ${my_density}
print    "m:${my_mass} V:${my_volume} rho:${my_density}" file info_mass.dat screen yes

#********************************************************************************
# Various computes
#********************************************************************************
compute E_kin_trans all ke
compute E_kin_rot all erotate/sphere
compute E_pot all pe
variable E_tot equal c_E_pot+c_E_kin_trans+c_E_kin_rot
compute Tall all temp/sphere dof all
# compute a all temp


# Nevery = input values this every timesteps
# Nrepeat = # of times input values should be read before averaging (usually 1, no averaging)
# Nfreq = calculate averages every this time step
fix fix_energies all ave/time 5000 1 5000  v_E_tot c_E_pot c_E_kin_trans c_E_kin_rot file energy.dat


##############################
########### MSD ##############
##############################
# compute msd_all all msd com yes average no
# variable        twopoint equal c_msd_all[4]/4/(step*dt+1.0e-6)
# fix             9 all vector 10 c_msd_all[4]
# variable        fitslope equal slope(f_9)/4/(10*dt)

# fix f_msd all ave/time ${t_dump} 1 ${t_dump} c_msd_all[1] c_msd_all[2] c_msd_all[3] c_msd_all[4] v_twopoint v_fitslope file msd.dat mode scalar


# ##############################
# ########### RDF ##############
# ##############################
# compute myRDF all rdf 100 1 1
# fix 1 all ave/time ${t_dump} 1 ${t_dump} c_myRDF[*] file rdf.out mode vector





##############################
######## PAIR STYLE ##########
##############################

# global cutoff DEBUG
pair_style      mesomem ${v_rcut}
# i j sigma eps ktilt ksplay rcut weightflag weight_rc

# 0.5 rad -> 30 degrees
# 0.1 rad -> 6 degrees
pair_coeff      1 1 1.0 1.0 ${v_tilt} ${v_splay} ${v_rcut} ${v_wc} ${v_zeta} ${v_alpha1}
pair_coeff      2 2 1.0 1.0 ${v_tilt} ${v_splay} ${v_rcut} ${v_wc} ${v_zeta} ${v_alpha2}
pair_coeff      1 2 1.0 0.7 ${v_tilt} ${v_splay} ${v_rcut} ${v_wc} ${v_zeta} ${v_alpha12}




# 2. Create a compute to read the pvector
# "my_terms" will generate a global vector corresponding to your pvector array
# Syntax: compute ID group-ID pair pair-style
# compute         my_terms all pair membrane_sillano_c0
#
#
# # 3. Define Variables for Averaging
# # Note: LAMMPS vector indices are 1-based (C++ [0] -> LAMMPS [1])
# variable        sum_lj equal c_my_terms[1]
# variable        sum_tilt equal c_my_terms[2]
# variable        sum_splay equal c_my_terms[3]
# variable        count  equal c_my_terms[4]
#
#
#
# # 3. Calculate Averages (Avoid division by zero)
# # Using a small epsilon or logic check is safer, but here is the direct physics:
# variable        avg_lj   equal v_sum_lj/v_count
# variable        avg_tilt   equal v_sum_tilt/v_count
# variable        avg_splay    equal v_sum_splay/v_count



# 4. Output to Thermo Log
thermo_style custom step spcpu cpuremain temp epair ke vol

# thermo_style custom step spcpu cpuremain temp epair ke v_avg_lj v_avg_tilt v_avg_splay v_count
thermo ${t_dump}



# dump coords all custom ${t_dump} position.lammpstrj id type xu yu zu ix iy iz vx vy vz mux muy muz omegax omegay omegaz fx fy fz tqx tqy tqz

dump coords all custom ${t_dump} position.lammpstrj id type xu yu zu mux muy muz

timestep        0.01

minimize 1.0e-8 1.0e-6 1000 10000

# fix      f_brown all brownian/sphere 1.0 1294019 gamma_t 100.0 gamma_r 100.0

fix             f_nve all nve/sphere update dipole
# fix             f_visc all viscous 10
# damp smalller, more viscous
compute        C_temp_baro all temp/sphere
compute        C_press_baro all pressure C_temp_baro
group type_A type 1
group type_B type 2
# fix fLANG   type_A   langevin 0.25 0.25 0.1 24233 zero yes omega yes
# fix fLANG   type_B   langevin 0.25 0.25 0.1 1233  zero yes omega yes
fix fLANG   all   langevin 0.1 0.1 1.0 1233  zero yes omega yes
# fix f_mom all momentum 1 linear 1 1 1 angular
run 500000


# unfix f_nve
# fix      fNPH_membrane         all     nph/sphere x 0.05 0.05 500.0  y 0.05 0.05 500.0 couple xy drag 10.0 dilate all nreset 100 update dipole
# fix_modify fNPH_membrane temp C_temp_baro press C_press_baro
# # unfix fLANG
# # fix fLANG   all   langevin 0.25 0.25 0.1 1233  zero yes omega no
# run 150000


# fix_modify fLANG temp Tall
# run 500000


